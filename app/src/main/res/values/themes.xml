<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.Vibe" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Customize your light theme here. -->
        <!-- <item name="colorPrimary">@color/my_light_primary</item> -->
    </style>

    <style name="Theme.Vibe" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="android:windowBackground">@drawable/gradient_splash</item>
    </style>
    <style name="Main.Theme.Vibe" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">#FF6F91</item>
        <item name="colorPrimaryDark">#FF6F91</item>
        <item name="android:statusBarColor">#FF6F91</item>
    </style>
    <style name="CustomSearchView" parent="Widget.AppCompat.SearchView">
        <item name="android:textColorHint">#5E5E5E</item>

        <item name="android:textColor">@android:color/black</item>
    </style>


    <style name="Theme.Vibe.Dialog.Dark" parent="ThemeOverlay.MaterialComponents.MaterialAlertDialog">
        <item name="colorSurface">#303030</item>
        <item name="shapeAppearanceOverlay">@style/Shape.Vibe.Dialog</item>
        <item name="materialAlertDialogTitleTextStyle">@style/TextStyle.Vibe.Dialog.Title</item>
        <item name="materialAlertDialogBodyTextStyle">@style/TextStyle.Vibe.Dialog.Body</item>
        <item name="buttonBarPositiveButtonStyle">@style/Button.Vibe.Dialog.Positive</item>
        <item name="buttonBarNegativeButtonStyle">@style/Button.Vibe.Dialog.Negative</item>
    </style>

    <style name="Shape.Vibe.Dialog" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">16dp</item>
    </style>

    <style name="TextStyle.Vibe.Dialog.Title" parent="MaterialAlertDialog.Material3.Title.Text">
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextStyle.Vibe.Dialog.Body" parent="MaterialAlertDialog.Material3.Body.Text">
        <item name="android:textColor">#E0E0E0</item>
    </style>

    <style name="Button.Vibe.Dialog.Negative" parent="Widget.Material3.Button.TextButton.Dialog">
        <item name="android:textColor">#BDBDBD</item>
    </style>

    <style name="Button.Vibe.Dialog.Positive" parent="Widget.Material3.Button.TextButton.Dialog">
        <item name="android:textColor">#FFFFFF</item>
        <item name="backgroundTint">#D32F2F</item>
    </style>

</resources>