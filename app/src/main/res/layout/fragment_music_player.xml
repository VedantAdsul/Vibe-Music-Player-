<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F6C7DA"
    android:fitsSystemWindows="true"
    tools:context=".MainActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_margin="20dp"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Now Playing: "
                android:textStyle="bold"
                android:textColor="#000000" />

            <TextView
                android:id="@+id/song_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:text="Blue - by Young Kai"
                android:textStyle="bold"
                android:textColor="#6A1B9A"
                android:textSize="18sp"
                android:maxLines="1"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium" />
        </LinearLayout>

        <FrameLayout
            android:id="@+id/image_frame"
            android:layout_width="match_parent"
            android:layout_height="250dp"
            android:layout_margin="30dp"
            android:background="@drawable/shape_song"
            android:clipToOutline="true"
            android:elevation="8dp">

            <ImageView
                android:id="@+id/song_image"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:src="@drawable/blue_youngkai"
                android:contentDescription="Song Image" />

            <ImageView
                android:id="@+id/icon_rewind"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:layout_gravity="center|start"
                android:layout_marginStart="10dp"
                android:alpha="0"
                android:src="@drawable/backward"
                app:tint="@android:color/white" />

            <ImageView
                android:id="@+id/icon_forward"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:layout_gravity="center|end"
                android:layout_marginEnd="10dp"
                android:alpha="0"
                android:src="@drawable/forward"
                app:tint="@android:color/white" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal">

                <View
                    android:id="@+id/tap_left"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@android:color/transparent" />

                <View
                    android:id="@+id/tap_right"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@android:color/transparent" />
            </LinearLayout>
        </FrameLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_margin="5dp"
            android:weightSum="100"
            android:gravity="center">

            <TextView
                android:id="@+id/song_currentTime"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="10"
                android:text="0:00"
                android:textStyle="bold"
                android:textColor="#000000" />

            <SeekBar
                android:id="@+id/song_progress"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="80"
                android:thumbTint="#9C27B0"
                android:progressTint="#7B1FA2"
                android:backgroundTint="#E1BEE7"
                android:splitTrack="false"
                android:paddingTop="8dp"
                android:paddingBottom="8dp" />

            <TextView
                android:id="@+id/song_totalTime"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="10"
                android:text="4:30"
                android:textStyle="bold"
                android:textColor="#000000" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="10dp"
            android:orientation="horizontal"
            android:gravity="center"
            android:weightSum="5">

            <ImageView
                android:id="@+id/btn_shuffle"
                android:layout_width="0dp"
                android:layout_height="31dp"
                android:layout_weight="1"
                android:src="@drawable/shuffle_button"
                app:tint="#000000"
                android:clickable="true" />

            <ImageView
                android:id="@+id/btn_previous"
                android:layout_width="0dp"
                android:layout_height="31dp"
                android:layout_weight="1"
                android:src="@drawable/previous_button"
                app:tint="#000000"
                android:clickable="true" />

            <ImageView
                android:id="@+id/btn_play"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:src="@drawable/play_button"
                app:tint="#000000"
                android:clickable="true" />

            <ImageView
                android:id="@+id/btn_next"
                android:layout_width="0dp"
                android:layout_height="31dp"
                android:layout_weight="1"
                android:src="@drawable/next_button"
                app:tint="#000000"
                android:clickable="true" />

            <ImageView
                android:id="@+id/btn_repeat"
                android:layout_width="0dp"
                android:layout_height="31dp"
                android:layout_weight="1"
                android:src="@drawable/repeat_button"
                app:tint="#000000"
                android:clickable="true" />
        </LinearLayout>
    </LinearLayout>

    <ListView
        android:id="@+id/listview"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginHorizontal="16dp"
        android:layout_weight="1"
        android:dividerHeight="1dp" />

</LinearLayout>
